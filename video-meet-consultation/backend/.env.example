# Database Settings
DATABASE_URL=postgresql://telemeet_user:telemeet_password@localhost:5433/telemeet_db

# Security & JWT
JWT_SECRET_KEY=telemeet_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# OpenRouter API Configuration (Recommended)
# Get your key at: https://openrouter.ai/keys
# You can use any model on OpenRouter:
#   - google/gemini-2.0-flash-exp:free (Fast & Free)
#   - meta-llama/llama-3.3-70b-instruct:free
#   - deepseek/deepseek-chat
#   - openai/gpt-4o-mini
# ==============================================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Other LLM Providers (Optional - If OpenRouter is not used)
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
